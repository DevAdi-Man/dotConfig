{
  "layer": "top",
  "position": "top",
  // "width": 1920,
  "modules-left": ["custom/workspaces", "custom/music", "custom/pomodoro", "custom/wallpaper"],
  "custom/workspaces": {
    "exec": "~/.config/waybar/scripts/workspaces.sh",
    "interval": 1,
    "format": "{}",
  },
  "modules-center": [
    "custom/launcher",
    "custom/cpu",
    "custom/ram",
    "custom/gpu",
    "clock",
  ],
  "modules-right": [
    "custom/volume",
    "network",
    "bluetooth",
    "backlight",
    "battery",
    "tray",
    "custom/lock",
    "custom/power",
  ],
  "custom/volume": {
    "exec": "~/.config/waybar/scripts/volume.sh",
    "return-type": "json",
    "interval": 0,
    "format": "{}",
    "tooltip": true,
    "on-click": "pavucontrol",
    "on-click-middle": "~/.scripts/vol-ctl-wrapper.sh mute",
    "on-scroll-up": "~/.scripts/vol-ctl-wrapper.sh raise",
    "on-scroll-down": "~/.scripts/vol-ctl-wrapper.sh lower",
  },
  "tray": {
    "icon-size": 21,
    "spacing": 10,
  },
  "custom/launcher": {
    "format": "",
    "on-click": "pkill -0 fuzzel || fuzzel",
    "tooltip": false,
  },
  "custom/music": {
    "exec": "~/.config/waybar/scripts/spotify.sh full",
    "interval": 1,
    "return-type": "json",
    "format": "  {text}",
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/spotify.sh next",
    "on-click-right": "~/.config/waybar/scripts/spotify.sh previous",
    "on-click-middle": "~/.config/waybar/scripts/spotify.sh play-pause",
    "on-scroll-up": "~/.config/waybar/scripts/spotify.sh vol-up",
    "on-scroll-down": "~/.config/waybar/scripts/spotify.sh vol-down",
    "max-length": 25,
  },
  "clock": {
    "timezone": "Asia/Kolkata",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": "󰃭 {:%d %b %Y}",
    "format": " {:%I:%M %p}",
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon}",
    "format-icons": ["", "", "", "", "", "", "", "", ""],
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon}",
    "format-charging": "󰂄",
    "format-plugged": "󰂄",
    "format-alt": "{icon}",
    "format-icons": ["󰂃", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
  },
  "custom/lock": {
    "tooltip": false,
    "on-click": "sleep 0.5s && swaylock",
    "format": "",
  },
  "custom/wallpaper": {
    "tooltip": false,
    "on-click": "~/.scripts/wallpaper.sh",
    "on-click-right": "~/.scripts/wallpaper.sh random",
    "format": "󰋩",
  },  "custom/power": {
    "tooltip": false,
    "on-click": "wlogout &",
    "format": "",
  },
  "custom/cpu": {
    "exec": "~/.config/waybar/scripts/sysmon.sh cpu",
    "interval": 2,
    "format": " {}%",
    "tooltip": true,
    "return-type": "json",
  },
  "custom/ram": {
    "exec": "~/.config/waybar/scripts/sysmon.sh ram",
    "interval": 5,
    "format": " {}%",
    "tooltip": true,
    "return-type": "json",
  },
  "custom/gpu": {
    "exec": "~/.config/waybar/scripts/sysmon.sh gpu",
    "interval": 5,
    "format": "  {}%",
    "tooltip": true,
    "return-type": "json",
  },
  "custom/pomodoro": {
    "exec": "~/.config/waybar/scripts/pomodoro.sh",
    "return-type": "json",
    "interval": 1,
    "format": "󰔛 {text}",
    "escape": false,
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/pomodoro.sh working",
    "on-click-middle": "~/.config/waybar/scripts/pomodoro.sh toggle",
    "on-click-right": "~/.config/waybar/scripts/pomodoro.sh wasting",
  },
  "network": {
    "format-wifi": "󰖩",
    "format-ethernet": "󰈀 {ifname}",
    "format-disconnected": "󰖪 Disconnected",
    "format-alt": "󰖩 {essid}",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}\nSignal: {signalStrength}%\nUp: {bandwidthUpBits} Down: {bandwidthDownBits}",
    "on-click-right": "nm-connection-editor",
    "on-click-middle": "nmcli device wifi rescan",
  },
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format-connected": "{controller_alias}\naddress: {controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "name:    {device_alias}\nbattery: {device_battery_percentage}%\naddress: {device_address}",
    "on-click": "blueman-manager || bluetoothctl",
  },
}
